# Copy to .env (or .env.local) and fill in. Never commit the filled-in file.

# Neon Postgres. Keep the Neon project and the Vercel deployment in the same
# region - the function-to-database round trip dominates latency. This project
# uses ap-southeast-1 (Singapore), so deploy Vercel functions to sin1.
# Disable scale-to-zero on the production branch: a cold start adds ~2s to a
# customer's first page load.
DATABASE_URL="postgresql://user:password@host.neon.tech/dbname?sslmode=require"

# Better Auth. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Production must use a different secret, set in the Vercel dashboard.
BETTER_AUTH_SECRET="at-least-32-characters"
BETTER_AUTH_URL="http://localhost:3000"

# Google OAuth. Optional - sign-in is hidden until both are set. Both or
# neither; a half-configured pair refuses to boot.
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Vercel Blob, for product photos uploaded through the admin console.
# Create a Blob store in the Vercel dashboard and link it to the project; the
# token is then injected automatically on Vercel. For local development, pull
# it with `vercel env pull` or copy it from the store's settings.
# Without it, every image upload in /admin fails; the rest of the console works.
BLOB_READ_WRITE_TOKEN=""

# Resend, for transactional email (welcome, password-reset OTP, later invoices).
# Optional: without RESEND_API_KEY every send becomes a logged no-op and the
# rest of the app is unaffected. Create a key at resend.com/api-keys.
RESEND_API_KEY=""
#
# EMAIL_FROM is the ONLY thing that changes when the sending domain verifies.
# Until then, "onboarding@resend.dev" is the sender Resend gives you - and it
# may only deliver to the address your Resend account is registered under.
# Anything else comes back 403. Testing therefore only reaches your own inbox.
#
# After verifying level40wellness.com at resend.com/domains, change this one
# line to e.g.
#   EMAIL_FROM="Level 40 Cafe <orders@level40wellness.com>"
# and then flip requireEmailVerification in src/server/auth.ts.
#
# Note the sender is @level40wellness.com, NOT @send.level40wellness.com. The
# "send" subdomain carries only the SPF/bounce path (MX + TXT); DKIM sits at
# resend._domainkey on the root. Because both live on a subdomain or a distinct
# selector, none of it collides with the Amazon WorkMail records already on
# level40wellness.com.
# EMAIL_FROM="Level 40 Cafe <onboarding@resend.dev>"
EMAIL_FROM="Level 40 Cafe <Level 40 Cafe <hello@level40wellness.com>>"
#
# Where replies land. Optional; without it replies go to EMAIL_FROM, which is
# not a mailbox anyone reads.
EMAIL_REPLY_TO="hello@level40wellness.com"

# Payments. "mock" refuses to boot in production unless ALLOW_MOCK_PAYMENTS=1.
PAYMENT_PROVIDER="mock"
# Signs and verifies webhooks. In production this is the value the real gateway
# gives you. Generate a dev one with the same command as BETTER_AUTH_SECRET.
PAYMENT_WEBHOOK_SECRET="at-least-32-characters"
# UAE VAT in basis points. 500 = 5%.
VAT_RATE_BP="500"
# Only the literal "1" unlocks mock payments when NODE_ENV=production - which
# includes `npm run start` and every Vercel deploy. Required until Stripe is
# connected in Phase 6, then delete it.
ALLOW_MOCK_PAYMENTS="1"
