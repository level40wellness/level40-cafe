# Copy to .env.local and fill in. Never commit .env.local.

# Neon Postgres. Pin the Neon project to the same region as the Vercel
# deployment (fra1/eu-central-1 or bom1/ap-south-1) — the function-to-database
# round trip dominates latency, and there is no Neon region in the UAE.
# Disable scale-to-zero on the production branch.
DATABASE_URL="postgresql://user:password@host.neon.tech/dbname?sslmode=require"
