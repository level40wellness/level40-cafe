# Copy to .env (or .env.local) and fill in. Never commit the filled-in file.

# Neon Postgres. Keep the Neon project and the Vercel deployment in the same
# region - the function-to-database round trip dominates latency. This project
# uses ap-southeast-1 (Singapore), so deploy Vercel functions to sin1.
# Disable scale-to-zero on the production branch: a cold start adds ~2s to a
# customer's first page load.
DATABASE_URL="postgresql://user:password@host.neon.tech/dbname?sslmode=require"

# Better Auth. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Production must use a different secret, set in the Vercel dashboard.
BETTER_AUTH_SECRET="at-least-32-characters"
BETTER_AUTH_URL="http://localhost:3000"

# Google OAuth. Optional - sign-in is hidden until both are set. Both or
# neither; a half-configured pair refuses to boot.
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
